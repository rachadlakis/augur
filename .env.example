# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file — add it to .gitignore.

# ── Mode ──────────────────────────────────────────────────────────
# "paper" uses testnet/paper-trading endpoints. Keep this until validated.
TRADING_MODE=paper   # paper | live

# ── Crypto: Binance ──────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── Stocks: Alpaca ───────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── Data providers ───────────────────────────────────────────────
NEWSAPI_KEY=
CRYPTOPANIC_API_KEY=
GLASSNODE_API_KEY=
POLYGON_API_KEY=
COINGECKO_API_KEY=
FRED_API_KEY=            # real yields (gold) and the policy-uncertainty index

# ── Watch-only wallets & whale tracking ──────────────────────────
# Augur never signs transactions and never needs a private key. Do NOT put one
# anywhere in this file. Public addresses only.
WATCH_WALLETS=            # comma-separated public 0x addresses to show balances for
WALLET_RPC_URL=           # blank = https://ethereum-rpc.publicnode.com
EXCHANGE_WALLETS=         # extra exchange hot wallets for whale flows: 0xabc...=Label,0xdef...=Other
