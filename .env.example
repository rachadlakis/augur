# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file — add it to .gitignore.

# ── Mode ──────────────────────────────────────────────────────────
# "paper" uses testnet/paper-trading endpoints. Keep this until validated.
TRADING_MODE=paper   # paper | live

# ── Crypto: Binance ──────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── Stocks: Alpaca ───────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── Data providers ───────────────────────────────────────────────
NEWSAPI_KEY=
CRYPTOPANIC_API_KEY=
GLASSNODE_API_KEY=
POLYGON_API_KEY=
COINGECKO_API_KEY=
FRED_API_KEY=

# ── Optional: on-chain / self-custody wallet ─────────────────────
# Only needed if trading directly on-chain (DEX/smart contracts).
# Leave blank if only trading through centralized exchanges.
WALLET_PRIVATE_KEY=
WALLET_RPC_URL=
